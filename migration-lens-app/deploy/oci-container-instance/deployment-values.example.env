# Copy this file to deployment-values.env and replace all placeholders.

export OCI_REGION_KEY="iad"
export OCI_TENANCY_NAMESPACE="<tenancy-namespace>"
export OCIR_REPOSITORY="migration-lens/prototype"
export IMAGE_TAG="0.1.0"
export IMAGE_NAME="${OCI_REGION_KEY}.ocir.io/${OCI_TENANCY_NAMESPACE}/${OCIR_REPOSITORY}:${IMAGE_TAG}"

export OCI_COMPARTMENT_OCID="<ocid1.compartment.oc1..example>"
export OCI_SUBNET_OCID="<ocid1.subnet.oc1..example>"
export OCI_AVAILABILITY_DOMAIN="<availability-domain-name>"

# The container listens on TCP 8080.
export APP_PORT="8080"
